#!/bin/bash

read -p "Enter filename to check: " filename

if [ -z "$filename" ]; then
    echo "Error: No filename entered."
exit 1
fi

if [ ! -e "$filename" ]; then
    echo "File '$filename' does not exist."
exit 1
fifile

if [ -r "$filename" ]; then
    echo "File is readable."
else 
    echo "File is not readable."
fi

if [ -w "$filename" ]; then
    echo "File is writable."
else 
    echo "File is not writable."
fi


ADDITION
#!/bin/bash

num1=10
num2=5

result=$((num1 + num2))
echo "The sum of $num1 and $num2 is: $result"

The sum of 10 and 5 is: 15

SUBTRACTION
#!/bin/bash

num1=10
num2=5

result=$((num1 - num2))
echo "The difference of $num1 and $num2 is: $result"

The difference of 10 and 5 is: 5

MULTIPLICATION 
#!/bin/bash

